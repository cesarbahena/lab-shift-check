<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShiftCheck.ViewModels"
             xmlns:models="clr-namespace:ShiftCheck.Models"
             x:Class="ShiftCheck.Views.CreateHandoverPage"
             Title="Crear Entrega de Turno">

    <ScrollView>
        <StackLayout Spacing="20" Padding="20">

            <Label Text="Fecha de Entrega"
                   FontSize="16"
                   FontAttributes="Bold" />
            <DatePicker Date="{Binding HandoverDate}"
                       Format="dd/MM/yyyy"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <Label Text="Turno"
                   FontSize="16"
                   FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Shifts}"
                   SelectedItem="{Binding SelectedShift}"
                   ItemDisplayBinding="{Binding Name}"
                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            <Label Text="{Binding ShiftLoadError}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding ShiftLoadError, Converter={StaticResource StringNotEmptyConverter}}" />
            <Button Text="Reintentar carga de turnos" Command="{Binding LoadShiftsCommand}"
                    IsVisible="{Binding ShiftLoadError, Converter={StaticResource StringNotEmptyConverter}}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <Label Text="Notas"
                   FontSize="16"
                   FontAttributes="Bold" />
            <Editor Text="{Binding Notes}"
                   HeightRequest="120"
                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <Label Text="Exámenes pendientes"
                   FontSize="16"
                   FontAttributes="Bold" />
            <Label Text="Revise el turno y escriba un motivo para cada examen antes de confirmar."
                   TextColor="{StaticResource Gray600}" />
            <StackLayout BindableLayout.ItemsSource="{Binding PendingItems}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="{StaticResource Gray200}" Padding="12" HasShadow="False">
                            <StackLayout Spacing="6">
                                <Label Text="{Binding Folio, StringFormat='Folio: {0}'}"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding ExamName}"
                                       TextColor="{StaticResource Gray600}" />
                                <Entry Text="{Binding Reason}"
                                       Placeholder="Motivo pendiente"
                                       MaxLength="500" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>

            <Label Text="{Binding SubmissionStatus}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding SubmissionStatus, Converter={StaticResource StringNotEmptyConverter}}" />
            <Label Text="El borrador sigue aquí. Salga para comprobar en Hub si la entrega se registró; no envíe otra desde este formulario."
                   TextColor="{StaticResource Gray600}" IsVisible="{Binding SubmissionNeedsReview}" />

            <StackLayout Spacing="10" Orientation="Horizontal" HorizontalOptions="Center">
                <Button Text="Revisar y guardar"
                       Command="{Binding SaveHandoverCommand}"
                       IsEnabled="{Binding CanSubmit}"
                       WidthRequest="160" />
                <Button Text="Cancelar"
                       Command="{Binding CancelCommand}"
                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                       BackgroundColor="{StaticResource Gray400}"
                       WidthRequest="120" />
            </StackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              IsVisible="{Binding IsBusy}"
                              HorizontalOptions="Center" />

        </StackLayout>
    </ScrollView>

</ContentPage>
